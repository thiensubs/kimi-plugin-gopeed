# CI-built native binaries — produced by .github/workflows per platform,
# never committed. The installer downloads them from the GitHub release.
bin/gopeed-dl-*
bin/gopeed-dl
!.github/workflows/

# Archify visual-check sidecars — contact sheet HTML and receipt JSON
# are test artifacts, never committed. PNG images are archify's native
# export and are committed to the repo for README display.
assets/*.visual-check.html
assets/*.visual-check.json
